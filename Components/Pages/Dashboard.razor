@page "/dashboard"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Dashboard</PageTitle>

<div class="min-h-screen w-full bg-rooted-page">
    <header class="grid h-20 grid-cols-[1fr_auto_1fr] items-center bg-rooted-header px-4 sm:px-8">
        <div></div>

        <h1 class="justify-self-center font-yatra text-[1.6rem] tracking-[3px] text-white sm:text-[2.2rem]">
            ROOTED
        </h1>

        <div class="flex items-center gap-4 justify-self-end">
            <button class="@IconBtn" @onclick="GoToProfile" title="Profile">
                <img src="/images/ProfileIcon.png" alt="Profile" class="h-[28px] w-[28px]" />
            </button>

            <button class="@IconBtn" @onclick="GoToSettings" title="Settings">
                <img src="/images/SettingsIcon.png" alt="Settings" class="h-[28px] w-[28px]" />
            </button>

            <button class="@IconBtn" @onclick="Logout" title="Log out">
                <img src="/images/LogoutIcon.png" alt="Logout" class="h-[28px] w-[28px]" />
            </button>
        </div>
    </header>

    <main class="flex flex-wrap gap-6 p-5 sm:p-8">
        <!-- Render existing goals to the left -->
        @foreach (var goal in goals)
        {
            <div class="flex h-[180px] w-[160px] flex-col items-center justify-center rounded-2xl bg-white p-4 shadow-[0_2px_4px_rgba(0,0,0,0.08)] transition duration-150 hover:-translate-y-0.5 hover:shadow-[0_4px_8px_rgba(0,0,0,0.12)]">
                <span class="text-center text-[0.95rem] font-bold text-black break-words line-clamp-5">
                    @goal
                </span>
            </div>
        }

        <!-- Plant a New Goal Button -->
        <div class="flex h-[180px] w-[160px] cursor-pointer flex-col items-center justify-center gap-3 rounded-2xl bg-rooted-card p-4 shadow-[0_2px_4px_rgba(0,0,0,0.08)] transition duration-150 hover:-translate-y-0.5 hover:shadow-[0_4px_8px_rgba(0,0,0,0.12)]"
             @onclick="OpenModal">
            <span class="text-center text-[0.95rem] font-bold text-rooted-ink">Plant a New</span>

            <span class="flex size-12 items-center justify-center rounded-full bg-white shadow-sm">
                <img src="/images/Flower%20Icon.png" alt="Plant Goal" class="h-[30px] w-[30px]" />
            </span>

            <span class="text-center text-[0.95rem] font-bold text-rooted-ink">Goal</span>
        </div>
    </main>

    <!-- Modal Popup Overlay -->
    @if (isModalOpen)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
             @onclick="CloseModal">
            <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl" @onclick:stopPropagation>
                <div class="flex items-center justify-between border-b pb-3">
                    <h2 class="text-lg font-bold text-rooted-ink">Plant a New Goal</h2>
                    <button class="text-gray-400 hover:text-gray-600" @onclick="CloseModal">&times;</button>
                </div>

                <div class="mt-4">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">
                        Your Goal
                    </label>
                    <input type="text"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-rooted-header focus:outline-none focus:ring-1 focus:ring-rooted-header"
                           placeholder="e.g., Read 15 minutes daily"
                           maxlength="100"
                           @bind="newGoalText"
                           @bind:event="oninput"
                           @onkeyup="HandleKeyUp"
                           autofocus />
                </div>

                <div class="mt-6 flex justify-end gap-2">
                    <button class="rounded-lg px-4 py-2 text-sm font-semibold text-gray-600 transition-colors hover:bg-gray-100"
                            @onclick="CloseModal">
                        Cancel
                    </button>
                    <button class="rounded-lg bg-rooted-header px-4 py-2 text-sm font-semibold text-white shadow transition-opacity hover:opacity-90 disabled:opacity-50"
                            disabled="@string.IsNullOrWhiteSpace(newGoalText)"
                            @onclick="SaveGoal">
                        Plant Goal
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const string IconBtn =
        "flex cursor-pointer items-center justify-center rounded-lg p-1.5 transition-colors duration-200 hover:bg-white/15";

    private bool isModalOpen = false;
    private string newGoalText = string.Empty;
    private List<string> goals = new();

    private void GoToProfile() => Nav.NavigateTo("/profile");
    private void GoToSettings() => Nav.NavigateTo("/settings");
    private void Logout() => Nav.NavigateTo("/");

    private void OpenModal()
    {
        newGoalText = string.Empty;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newGoalText))
        {
            SaveGoal();
        }
    }

    private void SaveGoal()
    {
        if (string.IsNullOrWhiteSpace(newGoalText)) return;

        goals.Add(newGoalText.Trim());
        isModalOpen = false;
    }
}