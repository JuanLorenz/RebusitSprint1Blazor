@page "/dashboard"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Dashboard</PageTitle>

<div class="min-h-screen w-full bg-rooted-page">
    <header class="grid h-20 grid-cols-[1fr_auto_1fr] items-center bg-rooted-header px-4 sm:px-8">
        <div></div>

        <h1 class="justify-self-center font-yatra text-[1.6rem] tracking-[3px] text-white sm:text-[2.2rem]">
            ROOTED
        </h1>

        <div class="flex items-center gap-4 justify-self-end">
            <button class="@IconBtn" @onclick="GoToProfile" title="Profile">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="white">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" />
                </svg>
            </button>

            <button class="@IconBtn" @onclick="GoToSettings" title="Settings">
                <svg viewBox="0 0 24 24" width="22" height="22">
                    <g fill="white">
                        <rect x="11" y="1" width="2" height="4" rx="1" />
                        <rect x="11" y="19" width="2" height="4" rx="1" />
                        <rect x="1" y="11" width="4" height="2" rx="1" />
                        <rect x="19" y="11" width="4" height="2" rx="1" />
                        <rect x="4.2" y="4.2" width="2" height="4" rx="1" transform="rotate(45 5.2 6.2)" />
                        <rect x="17.8" y="4.2" width="2" height="4" rx="1" transform="rotate(-45 18.8 6.2)" />
                        <rect x="4.2" y="15.8" width="2" height="4" rx="1" transform="rotate(-45 5.2 17.8)" />
                        <rect x="17.8" y="15.8" width="2" height="4" rx="1" transform="rotate(45 18.8 17.8)" />
                        <circle cx="12" cy="12" r="6" />
                    </g>
                    <circle cx="12" cy="12" r="2.5" fill="#7ea97e" />
                </svg>
            </button>

            <button class="@IconBtn" @onclick="Logout" title="Log out">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </button>
        </div>
    </header>

    <main class="flex flex-wrap gap-6 p-5 sm:p-8">
        <div class="flex h-[150px] w-[130px] cursor-pointer flex-col items-center justify-center gap-2.5 rounded-2xl bg-rooted-card shadow-[0_2px_4px_rgba(0,0,0,0.08)] transition duration-150 hover:-translate-y-0.5 hover:shadow-[0_4px_8px_rgba(0,0,0,0.12)]"
             @onclick="PlantNewGoal">
            <span class="text-center text-[0.85rem] font-bold text-rooted-ink">Plant a New</span>

            <span class="flex size-11 items-center justify-center rounded-full bg-white">
                <svg viewBox="0 0 40 40" width="28" height="28">
                    <g fill="#ef7d6b">
                        <circle cx="20" cy="10" r="8" />
                        <circle cx="20" cy="30" r="8" />
                        <circle cx="10" cy="20" r="8" />
                        <circle cx="30" cy="20" r="8" />
                    </g>
                    <circle cx="20" cy="20" r="6" fill="#f4c542" />
                </svg>
            </span>

            <span class="text-center text-[0.85rem] font-bold text-rooted-ink">Goal</span>
        </div>
    </main>
</div>

@code {
    private const string IconBtn =
        "flex cursor-pointer items-center justify-center rounded-lg p-1.5 transition-colors duration-200 hover:bg-white/15";

    private void GoToProfile() => Nav.NavigateTo("/profile");
    private void GoToSettings() => Nav.NavigateTo("/settings");
    private void Logout() => Nav.NavigateTo("/");
    private void PlantNewGoal() => Nav.NavigateTo("/goals/new");
}